# Robinhood Crypto API credentials.
# Copy to .env and fill in. .env is gitignored — never commit it.

# The API key Robinhood shows you after you enroll your PUBLIC key.
# Looks like: rh-api-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RH_API_KEY=

# The base64 PRIVATE key printed by generate_keys.py (the seed, 44 chars).
RH_PRIVATE_KEY=

# --- Safety rails -----------------------------------------------------
# Enforced in safety.py, applied by trader.Trader before any order is
# built. A violation aborts before the request reaches the network.

# Master kill switch. While false, no order is ever sent — place_order.py
# --execute still refuses. Leave false until you have watched it run.
TRADING_ENABLED=false

# Comma-separated allow-list of pairs the bot may touch. A symbol not on
# this list cannot be traded, typo or not.
ALLOWED_SYMBOLS=BTC-USD,ETH-USD

# Hard cap on the notional value of any SINGLE order, in USD.
MAX_ORDER_USD=25

# Market orders can fill worse than the quote. The cap above is tested
# against the quote padded by this percentage, so slippage cannot carry a
# fill past MAX_ORDER_USD.
SLIPPAGE_BUFFER_PCT=1

# Fat-finger guard for limit orders: reject a limit price more than this
# far from the mid. Catches a misplaced decimal before it rests on the
# book as a gift to somebody else.
MAX_LIMIT_DEVIATION_PCT=5

# Cumulative caps for one UTC day, tracked in state/ledger.json so they
# survive a restart. These are what stop a bug that loops from draining
# the account — MAX_ORDER_USD alone would not.
MAX_DAILY_USD=100
MAX_ORDERS_PER_DAY=10
