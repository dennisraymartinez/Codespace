# Copy to .env and fill in. NEVER commit .env.

# UUID issued by Robinhood when you enroll your public key.
RH_API_KEY=

# Base64 Ed25519 PRIVATE key from generate_keys.py.
# This is a bearer secret: anyone holding it can trade your account.
RH_PRIVATE_KEY=

# --- Safety rails ---

# true  = orders are logged and discarded, nothing is sent.  <-- default
# false = orders are REAL and spend REAL money.
RH_DRY_RUN=true

# Hard cap on the notional USD value of any single order.
RH_MAX_ORDER_USD=10
