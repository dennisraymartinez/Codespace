{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MPLBACKEND": "Agg",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python3 --version)",
      "Bash(python3 -c:*)",
      "Bash(python3 -m pip list)",
      "Bash(python3 -m py_compile:*)",
      "Bash(pip list)",
      "Bash(pip show:*)",
      "Bash(iconv:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*_key*)",
      "Read(./**/credentials*)",
      "Bash(git push:* main)",
      "Bash(git push:* origin main)"
    ]
  }
}
